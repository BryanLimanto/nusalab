# Copy this file to `.env` and fill in your real keys.
# `.env` is git-ignored. Never paste keys into Dart, vercel.json, or a tracked file.

# --- LLM (primary) -------------------------------------------------------
# Groq serves the chat model. Sign up at https://console.groq.com/keys
GROQ_API_KEY=
# Model id served by Groq for OpenAI's gpt-oss-120b.
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (embeddings + optional fallback LLM) -----------------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-2.0-flash

# --- Optional: hosted persistent ChromaDB -------------------------------
# Leave empty to use the in-memory store built from api/data/ta_metadata.json.
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION=ukp_ta

# --- Web ----------------------------------------------------------------
# Comma-separated allowed origins. "*" allows the public Flutter Web app.
ALLOWED_ORIGINS=*
